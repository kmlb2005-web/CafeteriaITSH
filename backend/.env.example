# Copiar a .env y completar. NUNCA versionar .env (docs/reglas.md §21, §23)

# Conexión (ver docs/ejecutar-migraciones.md)
DATABASE_URL=mysql://cafe_admin:cafeContra@127.0.0.1:3306/cafe_itsh

# Sesión JWT — generar un valor aleatorio fuerte por entorno
JWT_SECRET=cambiate-este-secreto-aleatorio-fuerte
JWT_EXPIRES_HOURS=8

# Servidor
NODE_ENV=development
PORT=3000

# Seed de cuentas operativas (solo se usan la primera vez; si se omiten,
# el seed genera contraseñas aleatorias y las imprime una sola vez)
SEED_ADMIN_PASSWORD=
SEED_CAJERO_PASSWORD=
SEED_COCINERO_PASSWORD=

# Solo demo/pruebas (Sprint 5): true fuerza el fallo del envío de correos
# para verificar que el estado Listo sigue visible y el sistema reintenta
SIMULAR_FALLO_CORREO=false
